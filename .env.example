# Zkopiruj tento soubor jako .env a vypln vlastnimi udaji z Cloudflare.
# SEM ZADNE SKUTECNE KLICE NEPATRI - tento soubor se verzuje.

# R2 -> Overview -> Account ID (nebo subdomena v S3 API adrese)
R2_ACCOUNT_ID=

# R2 -> Manage R2 API Tokens -> Create API Token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=hadejcenu-fotky

# Verejna adresa bucketu (r2.dev nebo vlastni domena), vcetne https://
R2_VEREJNA_URL=
